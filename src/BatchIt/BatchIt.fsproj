<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>Embedded</DebugType>
    <EmbedAllSources>True</EmbedAllSources>
    <Description>BatchIt lets you write F# async functions that handle many arguments at once, such as a database query for many IDs, and call them as if they handled one argument at a time.</Description>
    <PackageProjectUrl>https://github.com/cmeeren/BatchIt</PackageProjectUrl>
    <Authors>Christer van der Meeren</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>f# fsharp batching batch-processing</PackageTags>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>https://github.com/cmeeren/BatchIt/releases/tag/v/$(Version)</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\.agents\skills\batchit\SKILL.md" Pack="true" PackagePath="skills/SKILL.md" Visible="false" />
    <PackageReference Update="FSharp.Core" Version="4.6.2" />
  </ItemGroup>

</Project>
