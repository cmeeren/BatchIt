<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>Embedded</DebugType>
    <EmbedAllSources>True</EmbedAllSources>
    <Description>BatchIt lets you write an F# async function that takes an array of arguments, such as a database query for many IDs at once, and call it with a single argument at a time.</Description>
    <PackageProjectUrl>https://github.com/cmeeren/BatchIt</PackageProjectUrl>
    <Authors>Christer van der Meeren</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>f# fsharp batching batch-processing</PackageTags>
    <Version>2.0.0</Version>
    <PackageReleaseNotes>https://github.com/cmeeren/BatchIt/releases/tag/v/$(Version)</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\.agents\skills\batchit\SKILL.md" Pack="true" PackagePath="skills/SKILL.md" Visible="false" />
    <PackageReference Update="FSharp.Core" Version="4.6.2" />
    <!-- .NET 8 and later include it. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="6.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

</Project>
