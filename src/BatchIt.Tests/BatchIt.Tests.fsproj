<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Lets Faqt name the subjects of assertions in failure messages also when source paths are mapped. -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestUtils.fs" />
    <Compile Include="Timing.fs" />
    <Compile Include="MaxSize.fs" />
    <Compile Include="ItemsAndResults.fs" />
    <Compile Include="Extra.fs" />
    <Compile Include="Failures.fs" />
    <Compile Include="ExecutionContext.fs" />
    <Compile Include="SystemEnvironment.fs" />
    <Compile Include="Tracing.fs" />
    <Compile Include="Overloads.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Faqt" Version="6.0.0" />
    <PackageReference Include="xunit.v3.core.mtp-v2" Version="4.0.2" />
    <PackageReference Update="FSharp.Core" Version="8.0.401" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchIt\BatchIt.fsproj" />
  </ItemGroup>

</Project>
